// Cloudflare Workers config for the Part B SAQ programme's API (README.md), at saq.anantf.com. The app itself is
// anantf.com/exams/part-b/ on GitHub Pages. Separate from the mo.anantf.com Worker (../wrangler.jsonc).
// Secrets (Cloudflare dashboard → the Worker → Settings → Variables and secrets, or `npx wrangler secret put <NAME>`):
//   ANTHROPIC_API_KEY   Claude, for marking and for drafting missing model answers
//   RESEND_API_KEY      email: sign-in codes and marked scripts
//   SAQ_PASSPHRASE      the cohort passphrase, asked once when a candidate joins
//   FACULTY_EMAILS      comma-separated: who sees the cohort
//   COPY_TO             comma-separated: who gets a copy of every marked script
//   CODE_PEPPER         any long random string
{
  "name": "saq-marker",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    // pages allowed to call the API (comma-separated)
    "ALLOWED_ORIGINS": "https://anantf.com",
    // the sender, on a domain verified in Resend
    "EMAIL_FROM": "SAQ Programme <saq@anantf.com>",
    // markings per candidate per day, and across everyone per day: a ceiling on the bill
    "USER_DAILY_CAP": "25",
    "DAILY_CAP": "400"
  },
  // candidates, devices, attempts, drafted model answers; Cloudflare creates it on the first deploy, the Worker the tables
  "d1_databases": [{ "binding": "DB", "database_name": "saq-marker" }],
  "observability": { "enabled": true }
}
