// Cloudflare Workers config for the SAQ marker (README.md): the app in public/ and its API, at saq.anantf.com.
// Secrets (Cloudflare dashboard → the Worker → Settings → Variables and secrets, or `npx wrangler secret put <NAME>`):
//   ANTHROPIC_API_KEY, SAQ_PASSPHRASE, FACULTY_EMAILS (comma-separated, verified sign-ins only)
{
  "name": "saq-marker",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  "vars": {
    // from the Firebase console (Project settings → Your apps → web app); public by design
    "FIREBASE_CONFIG": { "apiKey": "", "authDomain": "", "projectId": "", "appId": "" },
    // markings per candidate per day, and across everyone per day: a ceiling on the bill
    "USER_DAILY_CAP": "25",
    "DAILY_CAP": "400"
  },
  // candidates and attempts; Cloudflare creates the database on the first deploy, the Worker creates the tables
  "d1_databases": [{ "binding": "DB", "database_name": "saq-marker" }],
  "observability": { "enabled": true }
}
