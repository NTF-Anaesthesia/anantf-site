{
  "name": "anantf-tci",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Space Plus TCI emulator (education only). Source for anantf.com/tci/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "golden": "python3 oracle/tci_ref.py --golden test/golden.json",
    "refs": "node tools/refs.mjs",
    "test": "vitest run",
    "e2e": "node test/e2e.mjs",
    "e2e:pump": "node test/pump.e2e.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
